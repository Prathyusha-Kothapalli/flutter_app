# Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database (local Docker)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/videoplatform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videoplatform
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_SSL=false

# JWT Authentication (REQUIRED - app won't start without these)
JWT_SECRET=super_secret_jwt_access_token_key_2026_video_platform
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_2026_video_platform
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Allow HTTP (for local development)
ALLOW_HTTP=true

# File Upload Security
# Max file size in bytes (default: 500MB)
MAX_FILE_SIZE=524288000
